{
  "name": "@tripboard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:check": "tsx src/db/cli.ts check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@fastify/multipart": "^10.1.2",
    "@tripboard/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "csv-parse": "^7.0.3",
    "ical.js": "^2.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unpdf": "^1.8.1",
    "vitest": "^3.2.4"
  }
}
