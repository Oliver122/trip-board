# Required. The API refuses to start when this is missing.
DATABASE_URL=postgres://tripboard:tripboard@localhost:5432/tripboard

# Non-default dev ports. Override if they collide with something else.
WEB_PORT=5180
API_PORT=4080

# Discord OAuth. Outside production the API still boots if these are unset.
# Register {WEB_ORIGIN}/api/auth/discord/callback as the Discord redirect URI.
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
AUTH_SECRET=replace-with-a-long-random-string
WEB_ORIGIN=http://127.0.0.1:5180
ADMIN_DISCORD_IDS=

# Nominatim proxy. Defaults are enough for local development.
# The API caches results for 30 days and sends at most one upstream request per second.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TripBoard/0.1 (local development)

# Image uploads (MinIO). Outside production these defaults are enough.
# In production the API refuses to start when the endpoint, bucket, or keys are missing.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tripboard
S3_ACCESS_KEY=tripboard
S3_SECRET_KEY=tripboard-secret
S3_REGION=us-east-1
