{
  "name": "tripboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm --filter @tripboard/web dev\" \"pnpm --filter @tripboard/api dev\"",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:req",
    "test:req": "node --test scripts/req/",
    "req:build": "node scripts/req/req.mjs",
    "req:check": "node scripts/req/req.mjs --check",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash scripts/run-e2e-tests.sh",
    "textures:template": "pnpm --filter @tripboard/web textures:template",
    "textures:manifest": "pnpm --filter @tripboard/web textures:manifest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev:e2e": "concurrently -k -n web,api -c cyan,magenta \"pnpm --filter @tripboard/web dev\" \"node scripts/dev-api-test.mjs\"",
    "dev:local": "concurrently -n web,api -c cyan,magenta \"pnpm --filter @tripboard/web dev\" \"pnpm --filter @tripboard/api dev:local\"",
    "db:migrate": "pnpm --filter @tripboard/api db:migrate",
    "db:seed": "pnpm --filter @tripboard/api db:seed",
    "db:check": "pnpm --filter @tripboard/api db:check",
    "db:metrics": "pnpm --filter @tripboard/api db:metrics",
    "push": "bash scripts/deploy.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "chrome-launcher": "^1.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
