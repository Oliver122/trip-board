# Copy to deploy.env. That file is not committed.
# Only keys with a value are written into the server .env.
# Leave a key empty to keep the value already on the server.

# Required to connect.
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PATH=/opt/trip-board
# Path to a private key. Leave empty to use the ssh agent.
DEPLOY_SSH_KEY=

# Required. Public origin. Discord redirect is {WEB_ORIGIN}/api/auth/discord/callback.
WEB_ORIGIN=http://127.0.0.1:5180

# First deploy. Without these, login stays on the .env.example placeholders.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SECRET=

# Optional. Empty keeps the server value.
DATABASE_URL=
WEB_PORT=
API_PORT=
ADMIN_DISCORD_IDS=
ADMIN_DISCORD_WEBHOOK_URL=
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
