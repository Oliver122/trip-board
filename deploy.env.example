# Copy to deploy.env. That file is not committed.
# Only keys you set here are written into the server .env.
# Leave a key unset to keep the value already on the server.

DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PATH=/opt/trip-board
# Optional path to a private key. Uses your ssh agent when unset.
# DEPLOY_SSH_KEY=

# Public origin the browser uses. Discord redirect is {WEB_ORIGIN}/api/auth/discord/callback.
WEB_ORIGIN=http://127.0.0.1:5180

# Optional overrides. Uncomment to replace the server value.
# DATABASE_URL=postgres://tripboard:tripboard@127.0.0.1:5432/tripboard
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# AUTH_SECRET=
# ADMIN_DISCORD_IDS=
# ADMIN_DISCORD_WEBHOOK_URL=
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=tripboard
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
